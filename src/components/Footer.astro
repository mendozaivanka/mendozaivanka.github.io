---
import { site } from "@/data/site";
import { getCv } from "@/lib/data";

const { pdf } = (await getCv()).profile;

const year = new Date().getFullYear();
const links = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about/" },
  { label: "Tools", href: "/tools/" },
  ...(pdf ? [{ label: "CV", href: pdf }] : []),
  { label: "Nordic Rose", href: "/nordic-rose/" },
  { label: "Contact", href: "/#contact" },
];
---

<footer class="mt-12 border-t sm:mt-16 border-border print:hidden">
  <div
    class="container-site flex flex-col items-start justify-between gap-3 pt-6 pb-[max(2rem,env(safe-area-inset-bottom,0px))] sm:flex-row sm:items-center"
  >
    <nav class="flex flex-wrap gap-x-4 gap-y-1" aria-label="Footer">
      {
        links.map((l) => (
          <a href={l.href} class="py-1 text-sm text-muted-foreground transition-colors hover:text-foreground">
            {l.label}
          </a>
        ))
      }
    </nav>
    <small class="text-[13px] text-muted-foreground">© {year} {site.name} · set in Nordic Rose · hosted on GitHub Pages</small>
  </div>
</footer>
