---
// Projects as a timeline by role: each job from the CV, newest first, with the work built in it, and the open-data
// side projects in a lane beside the current year. On phones it becomes one column per role.
import { cn } from "@/lib/utils";
import Layout from "@/layouts/Layout.astro";
import { site, coffee } from "@/data/site";
import { formatDate, type Role } from "@/data/cv";
import type { Project } from "@/data/projects";
import { getCv, getProjects } from "@/lib/data";

const [projects, cv] = await Promise.all([getProjects(), getCv()]);
const work = projects.filter((p) => p.kind === "work");

// A work project belongs to the role at its employer; "(internship)" projects go to the intern role.
const company = (s: string) => s.replace(/,?\s*Inc\.?$/i, "").replace(/\s*\(internship\)$/i, "").trim().toLowerCase();
const isIntern = (r: Role) => /intern/i.test(r.title);
const roleOf = (p: Project) =>
  cv.experience.find(
    (r) => p.org && company(r.company).startsWith(company(p.org)) && isIntern(r) === /internship/i.test(p.org),
  );

const year = (d: string | null) => (d ? d.slice(0, 4) : null);
const span = (r: Role) => {
  const a = year(r.start), b = year(r.end);
  return b === null ? `${a} –` : a === b ? a : `${a}–${b.slice(2)}`;
};

// Case studies first, then the rest, newest first
const rank = (p: Project) => (p.caseStudy ? 0 : 1);
const rows = cv.experience
  .map((r) => ({
    role: r,
    items: work.filter((p) => roleOf(p) === r).sort((a, b) => rank(a) - rank(b) || b.year - a.year),
  }))
  .filter((r) => r.items.length);

// Projects whose org matches no role still get listed, so nothing silently disappears
const placed = new Set(rows.flatMap((r) => r.items));
const unplaced = work.filter((p) => !placed.has(p));

const headline = (p: Project) => p.caseStudy?.evals.metrics[0];
const statusTint = { Live: "bg-moss", Building: "bg-sand", Planned: "bg-secondary" };
const dot = { Live: "bg-[#3fae7a]", Building: "bg-[#b9822e]", Planned: "bg-muted-foreground" };

/** Preview mini-markup: **rose**, ==fjord==. */
const marks = (line: string) =>
  line.split(/(\*\*[^*]+\*\*|==[^=]+==)/g).map((t) =>
    t.startsWith("**") ? { t: t.slice(2, -2), c: "text-primary-strong" } : t.startsWith("==") ? { t: t.slice(2, -2), c: "text-fjord-ink font-medium" } : { t, c: "" },
  );
---

<Layout title={`Projects — ${site.name}`} description={`AI, RAG and automation systems ${site.name} has built, role by role, plus her open-data coffee sites.`}>
  <section class="reveal grid max-w-[760px] gap-3 pt-8 sm:pt-14">
    <span class="label-mono">Projects · newest first</span>
    <h1 class="text-[clamp(2.25rem,5.2vw,3rem)] leading-[1.05] font-bold tracking-[-0.035em]">
      What I've <span class="text-primary-strong">built</span>, role by role
    </h1>
    <p class="text-[17px] leading-relaxed text-muted-foreground">
      Work grouped under the job it was built in. Internal systems are described at the level I can share; the numbers
      are the ones on my CV. The open-data side projects sit alongside.
    </p>
  </section>

  <div class="pt-10 sm:pt-12">
    <div class="hidden gap-x-6 pb-4 lg:grid lg:grid-cols-[96px_minmax(0,1fr)_320px]" aria-hidden="true">
      <span></span>
      <span class="flex items-center gap-2.5 text-sm text-muted-foreground"><span class="kind-chip bg-fjord text-fjord-ink">At work</span>Internal systems; numbers from my CV</span>
      <span class="flex items-center gap-2.5 text-sm text-muted-foreground"><span class="kind-chip bg-rosas-1 text-primary-strong">Side projects</span>Public</span>
    </div>

    <ol class="m-0 grid list-none gap-12 p-0 sm:gap-16 lg:gap-0">
      {
        rows.map((row, i) => (
          <li class="reveal grid gap-x-6 gap-y-4 lg:grid-cols-[96px_minmax(0,1fr)_320px] lg:border-t lg:border-border lg:py-10">
            <div class="font-mono text-sm font-medium text-muted-foreground lg:pt-1">
              <span class="text-2xl font-bold tracking-tight text-foreground lg:text-xl">{span(row.role)}</span>
            </div>

            <div class="grid min-w-0 content-start gap-3">
              <div class="grid gap-0.5 pb-1">
                <h2 class="text-xl leading-tight font-bold tracking-[-0.02em]">{row.role.title}</h2>
                <span class="label-mono">
                  {row.role.company.replace(/,?\s*Inc\.?$/, "")} · {formatDate(row.role.start)} – {row.role.end ? formatDate(row.role.end) : "now"}
                </span>
              </div>
              {row.items.map((p) => {
                const m = headline(p);
                return (
                  <article class="grid gap-4 rounded-[20px] border border-border bg-card p-5 sm:grid-cols-[minmax(0,1fr)_200px] sm:p-6">
                    <div class="grid content-start gap-1.5">
                      <h3 class="text-lg leading-snug font-bold tracking-[-0.01em]">{p.title}</h3>
                      <p class="text-[15px] leading-relaxed text-muted-foreground">{p.summary ?? p.description}</p>
                    </div>
                    <div class="grid content-start gap-0.5 max-sm:order-first sm:text-right">
                      {m ? (
                        <>
                          <span class="text-[clamp(2rem,4vw,2.5rem)] leading-none font-bold tracking-[-0.035em] text-primary-strong">{m.value}</span>
                          <span class="text-sm font-medium">{m.label}</span>
                          <span class="font-mono text-[11px] leading-snug text-muted-foreground">{m.note}</span>
                        </>
                      ) : p.period?.endsWith("–") ? (
                        <span class={cn("inline-flex w-fit items-center gap-1.5 justify-self-start rounded-full px-2.5 py-1 text-xs font-semibold sm:justify-self-end", statusTint.Building)}>
                          <span class={cn("size-1.5 rounded-full", dot.Building)} />Ongoing
                        </span>
                      ) : (
                        <span class="label-mono">{p.period ?? p.year} · internal</span>
                      )}
                    </div>
                    <div class="flex flex-wrap items-center gap-1.5 sm:col-span-2">
                      {p.tags.map((t) => <span class="rounded-full border border-border px-2.5 py-0.5 text-[13px]">{t}</span>)}
                      {p.caseStudy && (
                        <a href={`/projects/${p.caseStudy.slug}/`} class="ml-auto inline-flex min-h-11 items-center text-sm font-semibold text-primary-strong no-underline hover:underline">
                          Case study →
                        </a>
                      )}
                    </div>
                    {!m && p.period?.endsWith("–") && p.preview.length > 0 && (
                      <figure class="m-0 grid gap-1.5 sm:col-span-2">
                        <pre class="m-0 overflow-x-auto rounded-xl bg-muted px-4 py-3 font-mono text-[13px] leading-relaxed">{p.preview.map((line) => <span class="block">{marks(line).map((s) => <span class={s.c}>{s.t}</span>)}</span>)}</pre>
                        <figcaption class="text-[13px] text-muted-foreground">Illustrative run. Results will be added once they can be shared.</figcaption>
                      </figure>
                    )}
                  </article>
                );
              })}
            </div>

            {i === 0 ? (
              <aside class="grid content-start gap-3 max-lg:pt-4" aria-labelledby="side-h">
                <div class="grid gap-0.5 pb-1">
                  <span class="kind-chip w-fit bg-rosas-1 text-primary-strong lg:hidden">Side projects</span>
                  <h2 id="side-h" class="text-xl leading-tight font-bold tracking-[-0.02em]">Coffee, counted.</h2>
                  <span class="label-mono">Open-data sites · {coffee.length} sites</span>
                </div>
                {coffee.map((c) => (
                  <article class="grid gap-2 rounded-[16px] border border-border bg-card p-4">
                    <div class="flex items-center justify-between gap-2">
                      <h3 class="text-base font-bold">{c.name}</h3>
                      <span class={cn("inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-semibold", statusTint[c.status])}>
                        <span class={cn("size-1.5 rounded-full", dot[c.status])} />{c.status}
                      </span>
                    </div>
                    <p class="text-sm leading-relaxed text-muted-foreground">{c.blurb}.</p>
                    {c.results && (
                      <div class="flex flex-wrap gap-1.5">{c.results.map((r) => <span class="rounded-full bg-sand px-2.5 py-0.5 text-[13px]">{r}</span>)}</div>
                    )}
                    {c.href && (
                      <a href={c.href} class="inline-flex min-h-11 items-center text-sm font-semibold text-primary-strong no-underline hover:underline">
                        Open {c.name} ↗
                      </a>
                    )}
                  </article>
                ))}
              </aside>
            ) : (
              <span class="hidden lg:block" aria-hidden="true"></span>
            )}
          </li>
        ))
      }
    </ol>

    {
      unplaced.length > 0 && (
        <section class="pt-12" aria-label="Other work">
          <h2 class="text-xl font-bold">Other work</h2>
          <ul class="mt-3 grid list-none gap-2 p-0">{unplaced.map((p) => <li>{p.title}</li>)}</ul>
        </section>
      )
    }
  </div>
</Layout>

<style>
  .kind-chip {
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 10px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
