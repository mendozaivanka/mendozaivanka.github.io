---
import { cn } from "@/lib/utils";
import { ArrowRightIcon, ArrowUpRightIcon } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import BeltPreview from "@/components/BeltPreview.astro";
import CopyEmailButton from "@/components/CopyEmailButton";
import SocialIcon from "@/components/SocialIcon.astro";
import { buttonVariants } from "@/components/ui/button";
import { formatDate } from "@/data/cv";
import { coffee, site, socials } from "@/data/site";
import { getCv, getProjects } from "@/lib/data";

const [cv, projects] = await Promise.all([getCv(), getProjects()]);

const currentRole = cv.experience.find((r) => r.end === null) ?? cv.experience[0];
const caseStudies = projects
  .filter((p) => p.caseStudy)
  .map((p) => ({
    title: p.title,
    tagline: p.caseStudy!.tagline.split(":")[0],
    href: `/projects/${p.caseStudy!.slug}/`,
    metric: p.caseStudy!.evals.metrics[0],
  }));
// The second measured result of the anomaly-detection work (75% less monitoring) gets its own tile
const timeSaved = projects.flatMap((p) => p.caseStudy?.evals.metrics.slice(1) ?? [])[0];

const skillTint: Record<string, string> = {
  "AI / ML tools": "bg-fjord",
  Programming: "bg-heather",
  "Data & analytics": "bg-moss",
  Frameworks: "bg-sand",
};
const skills = ["AI / ML tools", "Programming", "Data & analytics", "Frameworks"].flatMap((group) =>
  (cv.skills.find((s) => s.group === group)?.items ?? []).slice(0, 4).map((label) => ({ label, cls: skillTint[group] })),
);

const coffeeTint = { rosas: "bg-rosas-1 text-primary-strong", sand: "bg-sand", fjord: "bg-fjord text-fjord-ink", heather: "bg-heather" };
const statusTint = { Live: "bg-moss", Building: "bg-sand", Planned: "bg-secondary" };

const tile = "flex min-w-0 flex-col gap-3 rounded-[20px] border border-border bg-card p-6";
---

<Layout title={`${cv.profile.fullName.split(" ")[0]} Mendoza · ${site.role}`}>
  <!-- ───────── Bento: who I am and the AI work ───────── -->
  <section class="grid gap-4 pt-8 sm:grid-cols-2 sm:pt-12 lg:grid-cols-4" aria-label="Introduction">
    <div class={cn(tile, "reveal justify-between gap-7 p-7 sm:col-span-2 sm:p-9 lg:row-span-2")}>
      <p class="label-mono">{site.role} · {site.location}</p>
      <div class="grid gap-4">
        <h1 class="text-[clamp(2.25rem,5.2vw,3.25rem)] leading-[1.04] font-bold tracking-[-0.035em]">
          I build AI systems, and the evals that keep them honest.
        </h1>
        <p class="max-w-[52ch] text-[17px] leading-relaxed text-muted-foreground">
          {currentRole.title} at {currentRole.company}: RAG, multi-agent workflows and model evaluation for enterprise QA. On
          weekends, open-data sites about coffee.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2.5">
        <a href="/about/" class={buttonVariants({ size: "lg" })}>See my work</a>
        {
          cv.profile.pdf && (
            <a href="/about/#cv" data-cv={cv.profile.pdf} class={cn(buttonVariants({ size: "lg", variant: "ghost" }))}>
              Download CV <ArrowRightIcon />
            </a>
          )
        }
      </div>
    </div>

    <div class={cn(tile, "reveal gap-1 sm:col-span-2 lg:row-span-2")}>
      <div class="flex items-center justify-between pb-2">
        <h2 class="label-mono">Case studies</h2>
        <a href="/about/" class="text-sm font-semibold text-primary-strong no-underline hover:underline">All work</a>
      </div>
      {
        caseStudies.map((c) => (
          <a
            href={c.href}
            class="group grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-4 gap-y-1 rounded-lg border-t border-border py-4 text-foreground no-underline outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
          >
            <span class="text-[17px] font-bold group-hover:text-primary-strong">{c.title}</span>
            <span class="text-[32px] font-bold tracking-[-0.03em] tabular-nums">{c.metric.value}</span>
            <span class="text-sm text-muted-foreground">{c.tagline}</span>
            <span class="text-right text-[13px] text-muted-foreground">{c.metric.label}</span>
          </a>
        ))
      }
    </div>

    <div class={cn(tile, "reveal")}>
      <h2 class="label-mono">Now</h2>
      <p class="text-[17px] font-bold tracking-tight">{currentRole.company}</p>
      <p class="text-sm leading-normal text-muted-foreground">{currentRole.title}, since {formatDate(currentRole.start)}</p>
    </div>

    {
      timeSaved && (
        <div class={cn(tile, "reveal")}>
          <h2 class="label-mono">Less manual work</h2>
          <p class="text-[44px] leading-none font-bold tracking-[-0.035em] tabular-nums">{timeSaved.value}</p>
          <p class="text-sm text-muted-foreground">{timeSaved.label}, after automated detection</p>
        </div>
      )
    }

    <div class={cn(tile, "reveal sm:col-span-2")}>
      <h2 class="label-mono">Tools I reach for</h2>
      <ul class="flex list-none flex-wrap gap-2 p-0">
        {skills.map((s) => <li class={cn("rounded-full px-2.5 py-1 text-xs font-semibold text-foreground", s.cls)}>{s.label}</li>)}
      </ul>
    </div>
  </section>

  <!-- ───────── Coffee atlas: the data side ───────── -->
  <section id="coffee" class="scroll-mt-20 pt-12 sm:pt-16" aria-labelledby="coffee-heading">
    <div class="horizon mb-8 border-b border-border sm:mb-10" aria-hidden="true"></div>
    <div class="reveal grid items-end gap-6 pb-7 md:grid-cols-2 md:gap-8">
      <div class="grid gap-3.5">
        <p class="label-mono">Open-data side projects</p>
        <h2 id="coffee-heading" class="text-[clamp(2rem,4.4vw,3rem)] leading-[1.04] font-bold tracking-[-0.035em]">
          Coffee, counted.
        </h2>
      </div>
      <p class="text-[17px] leading-relaxed text-muted-foreground">
        Four sites, from the cafés of Metro Manila to the belt of the world where coffee grows. Every number links to its
        source.
      </p>
    </div>

    <figure class="reveal m-0 overflow-hidden rounded-xl border border-border bg-card">
      <a href="/sinturon/" class="block px-2 pt-4 sm:px-4" aria-label="Open Sinturon, the bean belt map">
        <BeltPreview />
      </a>
      <figcaption class="flex flex-wrap items-center justify-between gap-3 border-t border-border px-5 py-4">
        <div class="grid gap-0.5">
          <span class="label-mono">Sinturon · live</span>
          <span class="font-bold">The bean belt, between the tropics</span>
          <span class="text-[13px] text-muted-foreground">12,514 open GBIF records of four coffee species; 93% fall between the tropics.</span>
        </div>
        <a href="/sinturon/" class={cn(buttonVariants({ size: "lg", variant: "outline" }), "bg-card")}>
          Explore Sinturon <ArrowRightIcon className="size-4" />
        </a>
      </figcaption>
    </figure>

    <ul class="grid list-none gap-3.5 p-0 pt-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        coffee.map((c) => {
          const body = (
            <>
              <div class={cn("flex h-30 items-center justify-center border-b border-border font-mono text-xs", coffeeTint[c.tint])}>
                {c.preview}
              </div>
              <div class="grid gap-2 p-4.5">
                <span class={cn("w-fit rounded-full px-2.5 py-1 text-xs font-semibold text-foreground", statusTint[c.status])}>{c.status}</span>
                <span class="flex items-center gap-1 text-lg font-bold">
                  {c.name}
                  {c.href && <ArrowUpRightIcon className="size-4 text-muted-foreground" />}
                </span>
                <span class="text-sm text-muted-foreground">{c.blurb}</span>
              </div>
            </>
          );
          return (
            <li class="reveal">
              {c.href ? (
                <a
                  href={c.href}
                  class="block h-full overflow-hidden rounded-xl border border-border bg-card text-foreground no-underline transition-colors outline-none hover:border-rosas-3 focus-visible:ring-3 focus-visible:ring-ring/50"
                >
                  {body}
                </a>
              ) : (
                <div class="h-full overflow-hidden rounded-xl border border-border bg-card">{body}</div>
              )}
            </li>
          );
        })
      }
    </ul>
  </section>

  <!-- ───────── Contact ───────── -->
  <section
    id="contact"
    class="reveal mt-12 flex scroll-mt-20 sm:mt-16 flex-wrap items-center justify-between gap-4 rounded-[20px] bg-primary p-7 text-primary-foreground"
    aria-labelledby="contact-heading"
  >
    <div>
      <h2 id="contact-heading" class="text-[22px] font-bold tracking-tight">Say hello</h2>
      <p class="mt-1 text-[15px] select-all">{site.email}</p>
    </div>
    <div class="flex flex-wrap items-center gap-x-2 gap-y-2 font-semibold">
      {
        socials.map((s) => (
          <a
            href={s.href}
            aria-label={s.name}
            title={s.name}
            class="inline-flex size-11 items-center justify-center rounded-full text-primary-foreground transition-colors hover:bg-primary-foreground/10 focus-visible:ring-3 focus-visible:ring-primary-foreground/40 focus-visible:outline-none"
          >
            <SocialIcon name={s.name} />
          </a>
        ))
      }
      {cv.profile.pdf && <a href="/about/#cv" data-cv={cv.profile.pdf} class="px-1 text-primary-foreground underline-offset-4 hover:underline">CV</a>}
      <CopyEmailButton client:idle email={site.email} />
    </div>
  </section>
</Layout>
