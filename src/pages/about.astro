---
// About: the CV and the work in one page. Masthead, the headline numbers (with how each was measured), then the CV
// three ways: a timeline by role with the projects built in each, the CV as JSON, and as a system prompt.
// /cv/ and /projects/ redirect here; case studies stay at /projects/<slug>/.
import { cn } from "@/lib/utils";
import Layout from "@/layouts/Layout.astro";
import CvView from "@/components/CvView";
import RoleTimeline from "@/components/RoleTimeline.astro";
import { buttonVariants } from "@/components/ui/button";
import { site } from "@/data/site";
import { getCv, getProjects } from "@/lib/data";

const [cv, projects] = await Promise.all([getCv(), getProjects()]);
const { profile } = cv;
const current = cv.experience.find((r) => r.end === null);
const names = profile.fullName.split(" ");

// Every case-study metric, in project order: the evidence leads the page
const metrics = projects.flatMap((p) => p.caseStudy?.evals.metrics.map((m) => ({ ...m, slug: p.caseStudy!.slug })) ?? []);
---

<Layout title={`About — ${profile.fullName}`} description={`${profile.fullName}: ${profile.title}. ${profile.summary.slice(0, 140)}…`}>
  <section class="reveal grid gap-4 pt-8 sm:pt-14">
    <span class="label-mono">About · work and CV</span>
    <h1 class="text-[clamp(2.25rem,5.6vw,3.5rem)] leading-[1.04] font-bold tracking-[-0.035em] text-balance">
      {names.slice(0, -1).join(" ")} <span class="text-primary-strong">{names.at(-1)}</span>
    </h1>
    <p class="text-xl leading-snug font-semibold tracking-[-0.01em] text-balance sm:text-[22px]">
      {profile.title}{current && <span class="font-normal text-muted-foreground"> · {current.company}</span>}
    </p>
    <p class="max-w-[72ch] leading-relaxed text-muted-foreground">{profile.summary}</p>
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
      <dl class="flex flex-wrap gap-x-6 gap-y-1 font-mono text-[13px]">
        <div class="flex gap-2"><dt class="text-muted-foreground">Based in</dt><dd>{profile.location}</dd></div>
        <div class="flex gap-2">
          <dt class="text-muted-foreground">Email</dt>
          <dd><a href={`mailto:${profile.email}`} class="text-primary-strong underline decoration-primary-strong/30 underline-offset-4 hover:decoration-current">{profile.email}</a></dd>
        </div>
      </dl>
      {profile.pdf && <a href={profile.pdf} download class={cn(buttonVariants({ size: "lg" }), "print:hidden")}>CV</a>}
    </div>
  </section>

  <section class="reveal pt-8 print:break-inside-avoid" aria-label="Headline results">
    <ul class="grid list-none gap-3 p-0 sm:grid-cols-2 lg:grid-cols-4">
      {
        metrics.map((m) => (
          <li>
            <a href={`/projects/${m.slug}/`} class="grid h-full gap-1 rounded-[20px] border border-border bg-card p-5 text-foreground no-underline transition-colors hover:border-rosas-3">
              <span class="text-[clamp(2rem,4vw,2.5rem)] leading-none font-bold tracking-[-0.035em] text-primary-strong">{m.value}</span>
              <span class="font-medium">{m.label}</span>
              <span class="font-mono text-[11px] leading-snug text-muted-foreground">{m.note}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="reveal pt-12 sm:pt-16" id="cv">
    <CvView client:load cv={cv}>
      <RoleTimeline />
    </CvView>
  </section>

  <section class="reveal pt-12 sm:pt-16 print:hidden">
    <div class="flex flex-wrap items-center justify-between gap-4 rounded-[20px] border border-border bg-card px-6 py-5">
      <p class="text-muted-foreground">Want the long version, or a role-specific one? Ask.</p>
      <a href={`mailto:${site.email}`} class={cn(buttonVariants())}>Email me</a>
    </div>
  </section>
</Layout>
